# Esta carpeta solo debe contener imagenes subidas desde el admin.
# Se deshabilita por completo la ejecucion de PHP como capa extra de seguridad.

# Bloquear ejecución de scripts PHP en esta carpeta
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(php|phtml|phar)$ - [F,L]
</IfModule>

# Denegar acceso directo a cualquier script, sin importar el handler activo
<FilesMatch "\.(php|phtml|phar|php\d*)$">
    Require all denied
</FilesMatch>
